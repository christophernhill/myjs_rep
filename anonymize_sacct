#!/usr/bin/env python3
"""Produce an anonymized copy of an sacct listing (see gpu_jobstats.py).

Usernames are replaced with user01_mit, user02_mit, ... (stable within one
run, assigned in order of first appearance) and the uid in states like
"CANCELLED by 20966" is replaced with a matching fake uid. All other fields
(jobids, timestamps, nodes, states) are kept, and lines are re-emitted with
sacct's right-justified column widths, so parsers and statistics behave the
same as on the original file.

Usage: anonymize_sacct real_jobs.txt > sample_jobs.txt
"""
import re
import sys

# Keep in sync with SACCT_LINE_RE in gpu_jobstats.py (duplicated so this
# utility has no third-party imports).
LINE_RE = re.compile(
    r"""^\s*(?P<partition>\S+)\s+(?P<user>\S+)\s+(?P<jobid>\S+)\s+
        (?P<state>\S.*?)\s+(?P<elapsed>(?:\d+-)?\d{1,2}:\d{2}:\d{2}(?:\.\d+)?)\s+
        (?P<submit>\S+)\s+(?P<start>\S+)\s+(?P<end>\S+)\s+(?P<node>\S.*?)\s*$""",
    re.VERBOSE,
)

if len(sys.argv) != 2:
    sys.exit(__doc__.strip().splitlines()[-1])

users: dict[str, str] = {}
uids: dict[str, str] = {}
skipped = 0
with open(sys.argv[1]) as fh:
    for line in fh:
        m = LINE_RE.match(line)
        if m is None:
            if line.strip():
                skipped += 1
            continue
        d = m.groupdict()
        d["user"] = users.setdefault(d["user"], f"user{len(users) + 1:02d}_mit")
        d["state"] = re.sub(
            r"(CANCELLED by )(\d+)",
            lambda s: s.group(1) + uids.setdefault(s.group(2), str(90000 + len(uids) + 1)),
            d["state"],
        )
        print(
            f"{d['partition']:>40} {d['user']:>40} {d['jobid']:>20} {d['state']:>30} "
            f"{d['elapsed']:>10} {d['submit']:>19} {d['start']:>19} {d['end']:>19} "
            f"{d['node']:>15} "
        )
if skipped:
    print(f"note: dropped {skipped} unparseable line(s)", file=sys.stderr)
print(f"anonymized {len(users)} user(s), {len(uids)} uid(s)", file=sys.stderr)
